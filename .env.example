# =============================================================================
# Hush - example configuration
#
# Copy to .env and fill in. Never commit the real .env.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Discord bot token, from the Bot tab of your application.
# https://discord.com/developers/applications
DISCORD_TOKEN=

# Comma-separated Discord user IDs with bot-owner access: system operations,
# global exports, backups and identity lookup.
# This is the ONLY place owner IDs are configured - nothing is hard-coded.
BOT_OWNER_IDS=

# PostgreSQL in production. Railway provides this automatically when you add a
# PostgreSQL service - reference it as ${{Postgres.DATABASE_URL}}.
# Note the +asyncpg driver.
# Local development may use SQLite: sqlite+aiosqlite:///./hush.sqlite3
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/hush

# Only used by docker-compose, which builds DATABASE_URL from it.
POSTGRES_PASSWORD=

# --- Runtime -----------------------------------------------------------------

# development | staging | production
# Production refuses to start on SQLite, which would be lost on redeploy.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Structured JSON logs. Recommended in production.
LOG_JSON=false

# Apply pending database migrations during startup. Keeps a Railway deploy to a
# single step. Set false if you run migrations separately.
RUN_MIGRATIONS_ON_START=true

# --- Public links (optional) --------------------------------------------------
# /about renders a button for each of these. Leave blank to hide the button.

SUPPORT_SERVER_URL=
GITHUB_URL=
PRIVACY_POLICY_URL=
TERMS_URL=

# --- Branding (optional) ------------------------------------------------------

BRAND_NAME=Hush
BRAND_TAGLINE=Anonymous confessions made simple.

# Shown on every public confession. Keep it honest - never promise that a user
# is untraceable.
BRAND_PRIVACY_NOTE=Anonymous to regular server members.

# Version normally comes from app/__version__.py. Only set this to override.
HUSH_VERSION=

# --- Storage ------------------------------------------------------------------
# On Railway, point these at a mounted volume (e.g. /data/backups) or they will
# be lost on redeploy. Exports are temporary and safe on ephemeral storage.

BACKUP_DIRECTORY=./backups
EXPORT_DIRECTORY=./exports
LOG_DIRECTORY=./logs

# --- Defaults for new servers -------------------------------------------------
# Server admins can change these per guild with /admin settings.

DEFAULT_CONFESSION_LIMIT=1500
DEFAULT_ALIAS_ROTATION_DAYS=14
RULES_VERSION=1
RATING_SCALE_MIN=1
RATING_SCALE_MAX=5

# --- Discovery ----------------------------------------------------------------

TRENDING_LIMIT=7
TRENDING_WINDOW_HOURS=24

# --- Retention ----------------------------------------------------------------

DRAFT_EXPIRY_MINUTES=30
EXPORT_RETENTION_HOURS=24
NOTIFICATION_MAX_ATTEMPTS=3

# --- Backups ------------------------------------------------------------------

BACKUP_ENABLED=true
BACKUP_HOURLY_RETENTION_HOURS=48
BACKUP_DAILY_RETENTION_DAYS=30
BACKUP_WEEKLY_RETENTION_DAYS=180

# --- Rate limits --------------------------------------------------------------

RATE_LIMIT_CONFESSIONS_PER_HOUR=5
RATE_LIMIT_REPORTS_PER_HOUR=10
RATE_LIMIT_INTERACTIONS_PER_MINUTE=40

# --- Database tuning (optional) -----------------------------------------------

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
