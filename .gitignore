# --- Secrets -----------------------------------------------------------------
# Never commit a real environment file. .env.example is the only one tracked.
.env
.env.*
!.env.example

# --- Databases ---------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# --- Generated runtime data --------------------------------------------------
# These contain confession content, moderation records and identity mappings.
logs/
exports/
backups/
!logs/.gitkeep
!exports/.gitkeep
!backups/.gitkeep

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Environments ------------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Editors -----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Temporary ---------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
